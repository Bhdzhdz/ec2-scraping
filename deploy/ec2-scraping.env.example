# Required: comma-separated AWS SSO/CLI profile names to scrape
EC2_SCRAPE_PROFILES=default

# Optional: comma-separated regions, or set EC2_SCRAPE_ALL_REGIONS=1
# EC2_SCRAPE_REGIONS=us-east-1,us-west-2
EC2_SCRAPE_ALL_REGIONS=0

# Database connection string (SQLite or MariaDB/MySQL)
EC2_SCRAPE_DSN=sqlite:////var/lib/ec2-scraping/ec2_inventory.db
# EC2_SCRAPE_DSN=mysql://user:password@127.0.0.1:3306/ec2_inventory

# Seconds between scrape cycles (default: 3600)
EC2_SCRAPE_INTERVAL=3600

# SSH Enrichment settings
EC2_SCRAPE_SSH=1
EC2_SCRAPE_SSH_ONLY_UNACCESSED=0
# EC2_SCRAPE_SSH_KEY_DIR=/etc/ec2-scraping/keys
# EC2_SCRAPE_SSH_KEYS=/etc/ec2-scraping/keys/id_ed25519
# EC2_SCRAPE_SSH_USERS=root,admin,ec2-user,centos
EC2_SCRAPE_SSH_PORT=22
EC2_SCRAPE_SSH_TIMEOUT=5.0
EC2_SCRAPE_SSH_CONCURRENCY=32
EC2_SCRAPE_SSH_PREFER_PUBLIC_IP=0
